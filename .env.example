# Environment Configuration Template
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Security & Rate Limiting (required - no defaults)
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
API_SECRET_KEY=change-me-to-a-32-character-minimum-secret-key
UNSUBSCRIBE_SECRET=change-me-to-a-32-character-minimum-unsubscribe-secret
PAYMENT_WEBHOOK_SECRET=change-me-to-a-32-character-minimum-webhook-secret
DATABASE_URL=postgresql://postgres:password@localhost:6543/postgres

# Caching
CACHE_DEFAULT_TTL_MS=300000

# Executive Calendar Booking (required)
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/brandmania-consultation/30min

# Site URL (required)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Proxy configuration
VERCEL=
TRUST_PROXY=
