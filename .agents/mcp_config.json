{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "<YOUR_SUPABASE_ACCESS_TOKEN>",
        "SUPABASE_PROJECT_REF": "<YOUR_SUPABASE_PROJECT_REF>"
      }
    },
    "google-developer-knowledge": {
      "command": "npx",
      "args": [
        "-y",
        "@google/developer-knowledge-mcp"
      ]
    }
  }
}
